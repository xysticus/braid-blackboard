(lang dune 3.17)

; Les dépendances du projet, l'équivalent de environment.yml côté OCaml. dune en tire ardoise.opam
; (ne pas le modifier à la main). Installation dans le switch local, depuis ocaml/ :
;   opam switch create . ocaml-base-compiler.5.4.1 --deps-only --with-test --with-dev-setup
; ou, si le switch existe déjà :
;   opam install . --deps-only --with-test --with-dev-setup

(generate_opam_files true)

(package
 (name ardoise)
 (allow_empty) ; la bibliothèque n'est pas publiée : le paquet ne sert qu'à déclarer les dépendances
 (synopsis "Ardoise à tresse : réécriture en OCaml des algorithmes de braid-blackboard")
 (depends
  (ocaml (>= 5.4))
  dune
  (alcotest :with-test)
  (yojson :with-test)
  (ocaml-lsp-server :with-dev-setup)
  ; ocaml-lsp-server 1.26.1 appelle Pid.of_int, retiré de stdune 3.25
  (stdune (and :with-dev-setup (< 3.25)))))
